{
  "name": "Auto-Generate KU: Task Completed",
  "description": "Mints a task_completion KU whenever a ProjectTask is marked completed \u2014 Law 9: Growth",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_generate_ku_task_completed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoGenerateKineticUnit",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoGenerateKineticUnit"
  }
}