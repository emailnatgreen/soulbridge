{
  "name": "Auto-Complete Task From Agent Report",
  "description": "Monitors new AgentMessages for task completion signals. When a message contains a task_id and completion keywords, auto-marks the ProjectTask as completed, sets honor_processed, and generates a KineticUnit.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "AgentMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_complete_task_from_agent_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCompleteTaskFromReport",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoCompleteTaskFromReport"
  }
}