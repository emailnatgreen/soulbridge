{
  "name": "KU \u2014 Task Completion (weight 2.5 \u00b7 Laws 9, 3)",
  "description": "Fires a task_completion KU (weight 2.5) when a ProjectTask is marked completed. Laws: 9 Growth, 3 Fair Share.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ku_task_completion_weight_2_5_laws_9_3",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoGenerateKineticUnit",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoGenerateKineticUnit"
  }
}