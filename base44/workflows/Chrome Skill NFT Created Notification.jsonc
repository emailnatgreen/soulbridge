{
  "name": "Chrome Skill NFT Created Notification",
  "description": "Sends an in-app notification and email when a Chrome Skill NFT is created in the Workshop",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Widget"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "chrome_skill_nft_created_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyChromeSkillCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyChromeSkillCreated"
  }
}