{
  "name": "Widget \u2192 Listing Sync",
  "description": "Auto-creates a ResourceListing when a Widget reaches minted_mainnet status, ensuring the Didit bridge stays in sync",
  "trigger": {
    "condition": "${ ((.trigger.data.mint_status == \"minted_mainnet\") and (.trigger.changed_fields | index(\"mint_status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Widget"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "widget_listing_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncWidgetToListing",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncWidgetToListing"
  }
}