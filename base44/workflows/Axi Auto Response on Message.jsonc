{
  "name": "Axi Auto Response on Message",
  "description": "Automatically generates Axi's response when a new message is added to a conversation",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "AgentMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "axi_auto_response_on_message",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "axiRespond",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "axiRespond"
  }
}