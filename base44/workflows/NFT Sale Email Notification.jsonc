{
  "name": "NFT Sale Email Notification",
  "description": "Sends a branded HTML email notification via Gmail whenever an NFT sale is delivered on the marketplace.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"delivered\") or (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "MarketplaceTransaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nft_sale_email_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNFTSale",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyNFTSale"
  }
}