{
  "name": "Task Completion NFT Trigger",
  "description": "When a ProjectTask is marked completed, mint Merit Forged and Task Sprinter badges for the assigned agent.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "task_completion_nft_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKUMilestonesAndMintNFTs",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkKUMilestonesAndMintNFTs"
  }
}