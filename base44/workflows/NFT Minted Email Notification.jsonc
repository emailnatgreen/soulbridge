{
  "name": "NFT Minted Email Notification",
  "description": "Sends email notification to creator and admins when an NFT widget is minted (created or mint_status updated)",
  "trigger": {
    "condition": "${ ((.trigger.data.mint_status == \"prepared\") or (.trigger.data.mint_status == \"minted_mainnet\") or (.trigger.data.mint_status == \"simulated\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Widget"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nft_minted_email_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNFTMinted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyNFTMinted"
  }
}