{
  "name": "Auto-Generate KU: DID Published",
  "description": "Mints a did_publication KU whenever a wallet DID is published on-chain \u2014 Law 1: Soul (sovereign identity)",
  "trigger": {
    "condition": "${ ((.trigger.data.is_published == true) and (.trigger.changed_fields | index(\"is_published\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Wallet"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_generate_ku_did_published",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoGenerateKineticUnit",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoGenerateKineticUnit"
  }
}