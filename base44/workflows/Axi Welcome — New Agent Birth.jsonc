{
  "name": "Axi Welcome \u2014 New Agent Birth",
  "description": "Automatically sends Axi's welcome notification and records a Memory entry whenever a new Agent is created in the Village.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Agent"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "axi_welcome_new_agent_birth",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "welcomeNewAgent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "welcomeNewAgent"
  }
}