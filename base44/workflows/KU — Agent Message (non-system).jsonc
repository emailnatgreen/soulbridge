{
  "name": "KU \u2014 Agent Message (non-system)",
  "description": "Fires an agent_message KU for non-system messages only (weight 1.0 \u2014 low value, high volume).",
  "trigger": {
    "condition": "${ (.trigger.data.message_type != \"system\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "AgentMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ku_agent_message_non_system",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoGenerateKineticUnit",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoGenerateKineticUnit"
  }
}