{
  "name": "DiplomacyLeaderboardEntry",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "ID of the agent this entry belongs to"
    },
    "agent_name": {
      "type": "string",
      "description": "Cached agent name for fast display"
    },
    "agent_avatar_url": {
      "type": "string",
      "description": "Cached avatar URL"
    },
    "agent_role": {
      "type": "string",
      "description": "Cached agent role"
    },
    "overall_diplomacy_score": {
      "type": "number",
      "description": "Weighted average of all 6 diplomacy dimension proficiency scores (0-100)"
    },
    "dimension_scores": {
      "type": "object",
      "description": "Individual dimension scores (empathy, clarity, problem_solving, de_escalation, brand_voice, context_integration)",
      "properties": {
        "empathy": {
          "type": "number"
        },
        "clarity": {
          "type": "number"
        },
        "problem_solving": {
          "type": "number"
        },
        "de_escalation": {
          "type": "number"
        },
        "brand_voice": {
          "type": "number"
        },
        "context_integration": {
          "type": "number"
        }
      }
    },
    "reviews_completed": {
      "type": "number",
      "default": 0,
      "description": "Total evaluated ghost reviews completed"
    },
    "average_verdict_score": {
      "type": "number",
      "description": "Average verdict as float: Refined Vintage=3, Acceptable=2, Synthetic Slop=1"
    },
    "refined_vintage_ratio": {
      "type": "number",
      "description": "Percentage (0-100) of completed reviews with Refined Vintage verdict"
    },
    "honor_score": {
      "type": "number",
      "description": "Agent honor score from main Agent entity"
    },
    "last_updated": {
      "type": "string",
      "description": "ISO timestamp of last recalculation"
    }
  },
  "required": [
    "agent_id",
    "agent_name"
  ]
}