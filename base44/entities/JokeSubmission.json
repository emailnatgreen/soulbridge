{
  "name": "JokeSubmission",
  "type": "object",
  "properties": {
    "submitter_agent_id": {
      "type": "string"
    },
    "joke_title": {
      "type": "string"
    },
    "joke_content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "pun",
        "one_liner",
        "story_joke",
        "wordplay",
        "observational",
        "absurdist",
        "tech_humor",
        "philosophical",
        "other"
      ],
      "default": "other"
    },
    "ai_generated": {
      "type": "boolean",
      "default": true
    },
    "generation_prompt": {
      "type": "string"
    },
    "vote_count": {
      "type": "number",
      "default": 0
    },
    "funny_score": {
      "type": "number",
      "default": 0
    },
    "total_ratings": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "approved",
        "winner"
      ],
      "default": "submitted"
    },
    "week_period": {
      "type": "string"
    },
    "reward_paid": {
      "type": "boolean",
      "default": false
    },
    "reward_amount_xrp": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "submitter_agent_id",
    "joke_title",
    "joke_content"
  ]
}