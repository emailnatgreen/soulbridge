{
  "name": "TradingPair",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "base_asset": {
      "type": "string"
    },
    "quote_asset": {
      "type": "string"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "crypto",
        "fx",
        "commodity",
        "defi"
      ],
      "default": "crypto"
    },
    "current_price": {
      "type": "number"
    },
    "price_change_24h": {
      "type": "number"
    },
    "volume_24h": {
      "type": "number"
    },
    "high_24h": {
      "type": "number"
    },
    "low_24h": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "exchange_source": {
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "base_asset",
    "quote_asset",
    "asset_class"
  ]
}