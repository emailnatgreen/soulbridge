{
  "name": "AgentConversation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "conversation_type": {
      "type": "string",
      "enum": [
        "direct",
        "group",
        "project",
        "role_based"
      ],
      "default": "direct"
    },
    "participant_agent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_id": {
      "type": "string"
    },
    "role_filter": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    },
    "last_message_preview": {
      "type": "string"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "title",
    "conversation_type",
    "participant_agent_ids"
  ]
}