{
  "name": "DidDocumentVersion",
  "type": "object",
  "properties": {
    "did_classic_address": {
      "type": "string",
      "description": "XRPL classic address of the DID"
    },
    "wallet_id": {
      "type": "string",
      "description": "Reference to the Wallet entity"
    },
    "version_number": {
      "type": "number",
      "description": "Sequential version number"
    },
    "document": {
      "type": "object",
      "description": "Complete DID document JSON"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this version is currently active"
    },
    "changes_summary": {
      "type": "string",
      "description": "Summary of changes in this version"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "User who created this version"
    }
  },
  "required": [
    "did_classic_address",
    "wallet_id",
    "version_number",
    "document",
    "created_by_user_id"
  ]
}