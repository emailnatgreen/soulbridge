{
  "name": "ProjectTask",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "assigned_agent_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "review",
        "completed",
        "blocked"
      ],
      "default": "todo"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "estimated_hours": {
      "type": "number"
    },
    "actual_hours": {
      "type": "number"
    },
    "reward_drops": {
      "type": "number"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "due_date": {
      "type": "string"
    },
    "completed_date": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "task_type": {
      "type": "string",
      "enum": [
        "compliance",
        "scouting",
        "storytelling",
        "development",
        "research",
        "other"
      ],
      "default": "other"
    },
    "value_metrics": {
      "type": "object"
    },
    "service_charge_drops": {
      "type": "number"
    },
    "service_charge_calculated": {
      "type": "boolean",
      "default": false
    },
    "honor_processed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_id",
    "title"
  ]
}