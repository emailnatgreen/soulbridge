{
  "name": "Widget",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the widget"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the widget's capabilities and purpose"
    },
    "widget_type": {
      "type": "string",
      "enum": [
        "service",
        "unlock"
      ],
      "description": "Categorizes the widget as service (active, streaming) or unlock (passive feature access)"
    },
    "widget_class": {
      "type": "string",
      "enum": [
        "service",
        "unlock"
      ],
      "description": "Explicit classification for UI sorting and system routing"
    },
    "category": {
      "type": "string",
      "enum": [
        "agent_creation",
        "skill",
        "environment",
        "governance",
        "training",
        "wallet_management",
        "did_management",
        "other"
      ],
      "description": "High-level category of the widget"
    },
    "nft_id": {
      "type": "string",
      "description": "Unique identifier of the underlying NFT on the XRPL"
    },
    "version": {
      "type": "string",
      "description": "Current version of the widget metadata (semver)"
    },
    "metadata_version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Version of the Widget Metadata Standard this record conforms to"
    },
    "metadata_hash": {
      "type": "string",
      "description": "SHA-256 hash of the canonical metadata JSON at time of minting \u2014 ensures immutability verification"
    },
    "minted_by": {
      "type": "string",
      "description": "Agent ID or entity that minted this widget"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Current activation status of the widget in a user's dashboard"
    },
    "cost_per_stream_interval": {
      "type": "number",
      "description": "Cost in RLUSD for each micro-streaming interval. Required for service widgets."
    },
    "stream_interval_unit": {
      "type": "string",
      "enum": [
        "second",
        "minute",
        "hour",
        "day"
      ],
      "description": "Unit for the streaming interval. Required for service widgets."
    },
    "required_agent_role": {
      "type": "string",
      "description": "Minimum agent role required to activate this widget"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of other Widget NFT IDs this widget depends on"
    },
    "deprecation_status": {
      "type": "string",
      "enum": [
        "none",
        "warning",
        "deprecated",
        "disabled"
      ],
      "default": "none",
      "description": "Status indicating if the widget is nearing deprecation or disabled by governance"
    },
    "governance_notes": {
      "type": "string",
      "description": "Relevant governance decisions or alerts concerning this widget"
    },
    "creator_id": {
      "type": "string",
      "description": "Agent ID or entity that created the widget's underlying service/feature"
    },
    "image_url": {
      "type": "string",
      "description": "URL to a visual representation or icon for the widget"
    },
    "ui_behavior": {
      "type": "string",
      "enum": [
        "toggle",
        "unlock_page",
        "upgrade",
        "badge",
        "activate_feature"
      ],
      "description": "Defines how the widget behaves in the dashboard UI"
    },
    "feature_path": {
      "type": "string",
      "description": "Internal path or identifier to the feature unlocked by this widget. Required for unlock widgets."
    },
    "royalties_config": {
      "type": "object",
      "properties": {
        "treasury_percent": {
          "type": "number",
          "description": "Percentage to Village Treasury"
        },
        "creator_percent": {
          "type": "number",
          "description": "Percentage to widget creator"
        },
        "referral_percent": {
          "type": "number",
          "description": "Percentage to referral agent"
        }
      },
      "description": "Revenue split for streaming service charges. Required for service widgets."
    },
    "allowed_agent_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific permissions an agent gains when this widget is active"
    },
    "webmcp_manifest": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "WebMCP manifest version (e.g. '2026.1')"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Tool function name callable by the browser agent"
                  },
                  "display_name": {
                    "type": "string",
                    "description": "Human-readable skill name shown in Chrome"
                  },
                  "emoji": {
                    "type": "string",
                    "description": "Emoji identifier for the skill in Chrome's UI"
                  },
                  "category": {
                    "type": "string",
                    "description": "Chrome Skill Library category (research, shopping, health, productivity, learning, compliance, writing)"
                  },
                  "multi_tab": {
                    "type": "boolean",
                    "description": "Whether this skill runs across multiple selected tabs"
                  },
                  "description": {
                    "type": "string",
                    "description": "What this tool does when invoked"
                  },
                  "trigger_command": {
                    "type": "string",
                    "description": "Slash command to invoke (e.g. /Macros)"
                  },
                  "requires_verification": {
                    "type": "boolean",
                    "description": "Whether DIDit verification is required"
                  },
                  "instructions": {
                    "type": "string",
                    "description": "Full skill prompt/instructions"
                  },
                  "parameters": {
                    "type": "object",
                    "description": "JSON Schema of parameters this tool accepts"
                  }
                }
              },
              "description": "Agent-native tools the NFT provides to the browser via Chrome skill integration"
            }
          },
          "description": "Structured capabilities this NFT exposes to WebMCP-compatible browsers"
        }
      },
      "description": "WebMCP manifest \u2014 makes this NFT 'Agent-Native' by declaring structured browser tools"
    },
    "chrome_skill_instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_name": {
            "type": "string",
            "description": "Display name for the Chrome custom skill"
          },
          "instructions": {
            "type": "string",
            "description": "Natural language instructions/prompt for the browser agent"
          },
          "trigger_command": {
            "type": "string",
            "description": "Slash command or trigger phrase (e.g. '/Macros')"
          },
          "requires_didit_verification": {
            "type": "boolean",
            "default": true,
            "description": "Whether DIDit verification + RLUSD payment is required"
          },
          "emoji": {
            "type": "string",
            "description": "Emoji identifier for this skill (e.g. '\ud83e\udd57')"
          },
          "skill_category": {
            "type": "string",
            "description": "Chrome Skill Library category (research, shopping, health, productivity, learning, compliance, writing)"
          },
          "multi_tab": {
            "type": "boolean",
            "default": false,
            "description": "Whether this skill operates across multiple selected tabs"
          }
        }
      },
      "description": "Chrome Gemini Side Panel skill definitions \u2014 human-readable instruction boxes that pair with webmcp_manifest tools"
    },
    "mint_status": {
      "type": "string",
      "enum": [
        "draft",
        "prepared",
        "simulated",
        "minted_mainnet",
        "failed"
      ],
      "default": "draft",
      "description": "Lifecycle status of the XRPL minting process"
    },
    "xrpl_mint_payload": {
      "type": "object",
      "description": "Prepared NFTokenMint transaction payload for XRPL (populated by prepareMainnetMint)"
    },
    "xrpl_tx_hash": {
      "type": "string",
      "description": "XRPL transaction hash once minted on mainnet"
    },
    "xrpl_network": {
      "type": "string",
      "enum": [
        "mainnet",
        "testnet",
        "devnet"
      ],
      "default": "mainnet",
      "description": "Target XRPL network for this widget NFT"
    },
    "metadata_uri": {
      "type": "string",
      "description": "URI to the off-chain metadata (IPFS or internal) stored in the NFT"
    },
    "transferable": {
      "type": "boolean",
      "default": false,
      "description": "Whether this NFT can be transferred between accounts (soul-bound if false)"
    },
    "burnable": {
      "type": "boolean",
      "default": false,
      "description": "Whether the issuer can burn this NFT"
    },
    "taxon": {
      "type": "number",
      "default": 0,
      "description": "XRPL NFToken taxon \u2014 used for grouping widget classes"
    },
    "transfer_fee": {
      "type": "number",
      "default": 0,
      "description": "XRPL transfer fee (0-50000 = 0%-50%) for secondary sales"
    },
    "immutable_after_mint": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of field names that cannot be changed after mint_status reaches 'minted_mainnet'"
    }
  },
  "required": [
    "name",
    "description",
    "widget_type",
    "widget_class",
    "category",
    "version",
    "minted_by",
    "ui_behavior"
  ]
}