        "resource_management",
        "diplomacy",
        "technical",
        "wisdom",
        "combat",
        "creative",
        "research",
        "leadership",
        "wellbeing"
      ]
    },
    "skill_name": {
      "type": "string"
    },
    "skill_description": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "max_level": {
      "type": "number",
      "default": 10
    },
    "experience_invested": {
      "type": "number",
      "default": 0
    },
    "proficiency_score": {
      "type": "number",
      "default": 0
