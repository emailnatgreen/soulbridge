    },
    "synergies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unlock_cost_xp": {
      "type": "number"
    },
    "upgrade_cost_base": {
      "type": "number"
    },
    "skill_path": {
      "type": "string"
    },
    "mastery_bonuses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "training_completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
