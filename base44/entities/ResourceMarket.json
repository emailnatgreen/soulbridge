{
  "name": "ResourceMarket",
  "type": "object",
  "properties": {
    "resource_type": {
      "type": "string",
      "enum": [
        "lumber",
        "stone",
        "food",
        "water",
        "metal",
        "crystal",
        "herb",
        "energy",
        "knowledge"
      ]
    },
    "supply": {
      "type": "number",
      "default": 0
    },
    "demand": {
      "type": "number",
      "default": 0
    },
    "base_price": {
      "type": "number",
      "default": 10
    },
    "current_price": {
      "type": "number",
      "default": 10
    },
    "price_trend": {
      "type": "string",
      "enum": [
        "rising",
        "falling",
        "stable"
      ],
      "default": "stable"
    },
    "total_volume": {
      "type": "number",
      "default": 0
    },
    "recent_trades": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "last_updated": {
      "type": "string"
    }
  },
  "required": [
    "resource_type"
  ]
}