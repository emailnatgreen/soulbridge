{
  "name": "TruthReport",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "The original user question"
    },
    "raw_answer": {
      "type": "string",
      "description": "Draft answer from the untrusted LLM"
    },
    "schema_version": {
      "type": "string",
      "default": "v1",
      "description": "Canonical schema version (TruthReportV1)"
    },
    "leaf1_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "Leaf 1: Atomic claims extracted from the answer"
    },
    "leaf2_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "description": "Leaf 2: Evidence gathered per claim"
    },
    "leaf3_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "veracity_score": {
            "type": "number"
          },
          "confidence": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Leaf 3: Verification scores per claim"
    },
    "leaf4_reasoning": {
      "type": "string",
      "description": "Leaf 4: Chain-of-thought reasoning across all claims"
    },
    "leaf5_policy": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "flag",
            "block"
          ]
        },
        "reason": {
          "type": "string"
        },
        "overall_veracity": {
          "type": "number"
        },
        "ruleset": {
          "type": "string"
        }
      },
      "description": "Leaf 5: Policy decision \u2014 allow, flag, or block (TruthPolicyV1)"
    },
    "leaf6_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk_type": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "affected_claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Leaf 6: Risk flags identified"
    },
    "leaf7_synthesis": {
      "type": "string",
      "description": "Leaf 7: Final synthesis \u2014 the verified answer"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "complete",
        "failed"
      ],
      "default": "processing",
      "description": "Pipeline status"
    },
    "processing_ms": {
      "type": "number",
      "description": "Total pipeline processing time in milliseconds"
    },
    "latency": {
      "type": "object",
      "properties": {
        "pipeline_ms": {
          "type": "number"
        },
        "llm_draft_ms": {
          "type": "number"
        },
        "claim_extraction_ms": {
          "type": "number"
        },
        "verification_ms": {
          "type": "number"
        },
        "synthesis_ms": {
          "type": "number"
        },
        "hash_ms": {
          "type": "number"
        }
      },
      "description": "Per-step latency breakdown for engine health monitoring"
    },
    "report_hash": {
      "type": "string",
      "description": "SHA-256 hash of the canonical report payload (sorted keys)"
    },
    "hash_algo": {
      "type": "string",
      "default": "sha256",
      "description": "Hash algorithm used for report_hash"
    },
    "veracity_summary": {
      "type": "object",
      "properties": {
        "avg_score": {
          "type": "number"
        },
        "min_score": {
          "type": "number"
        },
        "max_score": {
          "type": "number"
        },
        "claims_count": {
          "type": "number"
        },
        "risks_count": {
          "type": "number"
        }
      },
      "description": "Pre-computed veracity statistics \u2014 one computation, many surfaces"
    },
    "node3_outbox": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "sent",
            "confirmed",
            "failed"
          ]
        },
        "payload_hash": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "hash_algo": {
          "type": "string"
        },
        "queued_at": {
          "type": "string"
        },
        "sent_at": {
          "type": "string"
        },
        "confirmed_at": {
          "type": "string"
        }
      },
      "description": "Node 3 outbox \u2014 tracks report submission to the decentralised layer"
    },
    "nft_metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "report_id": {
          "type": "string"
        },
        "report_hash": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "veracity": {
          "type": "object",
          "properties": {
            "avg_score": {
              "type": "number"
            },
            "min_score": {
              "type": "number"
            },
            "max_score": {
              "type": "number"
            },
            "claims_count": {
              "type": "number"
            }
          }
        },
        "engine": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        }
      },
      "description": "ResearchNFTMetadataV1 \u2014 frozen shape for minting"
    },
    "mint_intent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has signalled intent to mint this report as an NFT"
    },
    "mint_intent_at": {
      "type": "string",
      "description": "ISO timestamp of mint intent signal"
    },
    "email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the report email was delivered"
    },
    "node3_hook": {
      "type": "string",
      "default": "stub",
      "description": "Node 3 integration status"
    },
    "base44_hook": {
      "type": "string",
      "default": "stub",
      "description": "Base44 on-chain integration status"
    }
  },
  "required": [
    "question"
  ]
}