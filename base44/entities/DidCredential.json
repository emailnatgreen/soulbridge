{
  "name": "DidCredential",
  "type": "object",
  "properties": {
    "issuer_did": {
      "type": "string"
    },
    "subject_did": {
      "type": "string"
    },
    "issuer_wallet_id": {
      "type": "string"
    },
    "subject_wallet_id": {
      "type": "string"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "identity_verified",
        "skill_certification",
        "professional_license",
        "educational_degree",
        "membership",
        "authorization",
        "achievement",
        "compliance_attestation",
        "custom"
      ]
    },
    "credential_name": {
      "type": "string"
    },
    "credential_data": {
      "type": "object"
    },
    "proof": {
      "type": "object"
    },
    "issuance_date": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired",
        "suspended"
      ],
      "default": "active"
    },
    "revocation_reason": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string"
    },
    "is_verified": {
      "type": "boolean",
      "default": true
    },
    "verification_count": {
      "type": "number",
      "default": 0
    },
    "last_verified": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "shared"
      ],
      "default": "private"
    }
  },
  "required": [
    "issuer_did",
    "subject_did",
    "credential_type",
    "credential_name"
  ]
}