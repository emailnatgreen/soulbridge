{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "classic_address": {
      "type": "string"
    },
    "encrypted_seed": {
      "type": "string"
    },
    "encryption_iv": {
      "type": "string"
    },
    "encryption_salt": {
      "type": "string"
    },
    "network": {
      "type": "string",
      "enum": [
        "testnet",
        "mainnet"
      ],
      "default": "mainnet"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "last_accessed": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "published_at": {
      "type": "string"
    },
    "published_txid": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "network"
  ]
}