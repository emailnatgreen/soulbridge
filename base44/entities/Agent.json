{
  "name": "Agent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "wallet_id": {
      "type": "string"
    },
    "classic_address": {
      "type": "string"
    },
    "external_classic_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "purpose": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "citizen",
        "guardian",
        "creator",
        "trader",
        "teacher",
        "healer",
        "scout",
        "elder",
        "master"
      ],
      "default": "citizen"
    },
    "role_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "honor_score": {
      "type": "number",
      "default": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "dormant",
        "suspended",
        "probation"
      ],
      "default": "active"
    },
    "is_serving": {
      "type": "boolean",
      "default": false
    },
    "permissions": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "parent_agent_id": {
      "type": "string"
    },
    "total_transactions": {
      "type": "number",
      "default": 0
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "specializations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "core_skills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "portfolio": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "away",
        "do_not_disturb"
      ],
      "default": "available"
    },
    "hourly_rate_rlusd": {
      "type": "number"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "social_links": {
      "type": "object"
    },
    "testimonials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "purpose"
  ]
}