{
  "name": "GrantProposal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Grant proposal title"
    },
    "description": {
      "type": "string",
      "description": "Summary of the grant proposal"
    },
    "grant_program": {
      "type": "string",
      "enum": [
        "ripple_xrpl_grants",
        "ripple_creator_fund",
        "ripple_defi_fund",
        "ripple_cbdc_fund",
        "ripple_ai_fund",
        "ripple_accelerator",
        "other"
      ],
      "default": "ripple_xrpl_grants",
      "description": "Which Ripple grant program this targets"
    },
    "use_case_category": {
      "type": "string",
      "enum": [
        "defi",
        "rwa_tokenization",
        "payments",
        "trade_finance",
        "ai",
        "infrastructure",
        "developer_tooling",
        "other"
      ],
      "description": "XRPL Grants priority use case category"
    },
    "status": {
      "type": "string",
      "enum": [
        "drafting",
        "submitted",
        "under_review",
        "approved",
        "rejected",
        "in_progress",
        "milestone_review",
        "completed",
        "cancelled"
      ],
      "default": "drafting",
      "description": "Current proposal status"
    },
    "ai_project_id": {
      "type": "string",
      "description": "Linked AIProject entity ID"
    },
    "github_repo_url": {
      "type": "string",
      "description": "URL of the dedicated GitHub repository"
    },
    "github_repo_name": {
      "type": "string",
      "description": "GitHub repository name"
    },
    "requested_amount_usd": {
      "type": "number",
      "description": "Grant amount requested in USD"
    },
    "approved_amount_usd": {
      "type": "number",
      "description": "Approved grant amount in USD"
    },
    "xrp_allocation": {
      "type": "number",
      "description": "XRP allocation if applicable"
    },
    "proposal_lead": {
      "type": "string",
      "description": "Agent ID or name of the proposal lead"
    },
    "team_members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "github_url": {
            "type": "string"
          },
          "linkedin_url": {
            "type": "string"
          },
          "technical_skills": {
            "type": "string"
          }
        }
      },
      "description": "Team members involved in the proposal"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "target_date": {
            "type": "string"
          },
          "deliverables": {
            "type": "string"
          },
          "budget_usd": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "submitted",
              "approved",
              "rejected"
            ]
          },
          "github_issue_number": {
            "type": "number"
          },
          "success_criteria": {
            "type": "string"
          }
        }
      },
      "description": "Grant milestones with deliverables"
    },
    "xrpl_integration": {
      "type": "object",
      "properties": {
        "xrpl_features_used": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "XRPL features leveraged (e.g. DEX, Hooks, AMM, DID, NFTs, Escrow, Payment Channels)"
        },
        "onchain_activity_description": {
          "type": "string",
          "description": "How this project drives on-chain transactions on XRPL"
        },
        "xrpl_network": {
          "type": "string",
          "enum": [
            "mainnet",
            "testnet",
            "devnet",
            "both"
          ],
          "description": "Which XRPL network(s) the project targets"
        },
        "integration_timeline": {
          "type": "string",
          "description": "When XRPL integration is planned/completed"
        }
      },
      "description": "XRPL-specific integration details \u2014 critical for grant judges"
    },
    "market_opportunity": {
      "type": "object",
      "properties": {
        "problem_statement": {
          "type": "string",
          "description": "What problem does this solve?"
        },
        "target_market": {
          "type": "string",
          "description": "Who is the target audience?"
        },
        "market_size": {
          "type": "string",
          "description": "Estimated addressable market"
        },
        "competitive_landscape": {
          "type": "string",
          "description": "Key competitors and differentiation"
        }
      },
      "description": "Market opportunity assessment"
    },
    "traction": {
      "type": "object",
      "properties": {
        "users": {
          "type": "number",
          "description": "Number of users"
        },
        "transactions": {
          "type": "number",
          "description": "Number of on-chain transactions"
        },
        "revenue_usd": {
          "type": "number",
          "description": "Revenue generated"
        },
        "partnerships": {
          "type": "string",
          "description": "Notable partnerships or integrations"
        },
        "community_size": {
          "type": "number",
          "description": "Community/social following"
        },
        "traction_summary": {
          "type": "string",
          "description": "Overall traction narrative"
        }
      },
      "description": "Project traction metrics"
    },
    "sustainability_plan": {
      "type": "string",
      "description": "Long-term financial sustainability plan beyond grant funding"
    },
    "technical_architecture": {
      "type": "string",
      "description": "Overview of technical architecture and stack"
    },
    "submission_date": {
      "type": "string",
      "description": "When the proposal was submitted to Ripple"
    },
    "approval_date": {
      "type": "string",
      "description": "When the proposal was approved"
    },
    "completion_date": {
      "type": "string",
      "description": "When the grant was completed"
    },
    "proposal_document_url": {
      "type": "string",
      "description": "Link to the main proposal document"
    },
    "budget_breakdown": {
      "type": "object",
      "properties": {
        "development": {
          "type": "number"
        },
        "research": {
          "type": "number"
        },
        "infrastructure": {
          "type": "number"
        },
        "marketing": {
          "type": "number"
        },
        "operations": {
          "type": "number"
        },
        "other": {
          "type": "number"
        }
      },
      "description": "Budget breakdown by category"
    },
    "ripple_contact": {
      "type": "string",
      "description": "Ripple contact person or team"
    },
    "external_links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "External links (Ripple portal, documentation, etc.)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or context"
    }
  },
  "required": [
    "title",
    "description",
    "grant_program"
  ]
}