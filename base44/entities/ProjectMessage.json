{
  "name": "ProjectMessage",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "sender_agent_id": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "status_update",
        "milestone_complete",
        "task_complete",
        "question",
        "file_share"
      ],
      "default": "text"
    },
    "content": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "related_task_id": {
      "type": "string"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_id",
    "sender_agent_id",
    "content"
  ]
}