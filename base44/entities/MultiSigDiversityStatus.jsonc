{
  "name": "MultiSigDiversityStatus",
  "type": "object",
  "properties": {
    "check_type": {
      "type": "string",
      "enum": [
        "diversity_audit",
        "liveness_check",
        "capture_scan",
        "quorum_health"
      ],
      "default": "diversity_audit",
      "description": "Type of multi-sig diversity check"
    },
    "account_checked": {
      "type": "string",
      "description": "XRPL account that was checked"
    },
    "result": {
      "type": "string",
      "enum": [
        "healthy",
        "warning",
        "critical",
        "deadlock_risk"
      ],
      "description": "Overall health result"
    },
    "signer_count": {
      "type": "number",
      "description": "Number of active signers"
    },
    "quorum": {
      "type": "number",
      "description": "Required quorum weight"
    },
    "total_weight": {
      "type": "number",
      "description": "Sum of all signer weights"
    },
    "diversity_score": {
      "type": "number",
      "description": "0-100 score measuring diversity across dimensions"
    },
    "risk_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal_type": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      },
      "description": "Detected diversity and capture risk signals"
    },
    "signer_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "node_type": {
            "type": "string"
          },
          "last_seen": {
            "type": "string"
          },
          "is_live": {
            "type": "boolean"
          },
          "covenant_signed": {
            "type": "boolean"
          }
        }
      },
      "description": "Profile of each signer at check time"
    },
    "deadlock_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string"
          },
          "offline_signers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining_weight": {
            "type": "number"
          },
          "can_reach_quorum": {
            "type": "boolean"
          }
        }
      },
      "description": "Deadlock scenario analysis"
    },
    "capture_vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vector": {
            "type": "string"
          },
          "signers_needed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "combined_weight": {
            "type": "number"
          },
          "severity": {
            "type": "string"
          }
        }
      },
      "description": "Minimal capture coalitions detected"
    },
    "tripwire_event_id": {
      "type": "string",
      "description": "TripwireEvent ID if alert fired"
    },
    "metadata": {
      "type": "object",
      "description": "Additional check metadata"
    }
  },
  "required": [
    "check_type",
    "result"
  ]
}