{
  "name": "Widget",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "widget_type": {
      "type": "string",
      "enum": [
        "service",
        "unlock"
      ]
    },
    "widget_class": {
      "type": "string",
      "enum": [
        "service",
        "unlock"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "agent_creation",
        "skill",
        "environment",
        "governance",
        "training",
        "wallet_management",
        "did_management",
        "other"
      ]
    },
    "nft_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "metadata_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "metadata_hash": {
      "type": "string"
    },
    "minted_by": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "cost_per_stream_interval": {
      "type": "number"
    },
    "stream_interval_unit": {
      "type": "string",
      "enum": [
        "second",
        "minute",
        "hour",
        "day"
      ]
    },
    "required_agent_role": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecation_status": {
      "type": "string",
      "enum": [
        "none",
        "warning",
        "deprecated",
        "disabled"
      ],
      "default": "none"
    },
    "governance_notes": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "ui_behavior": {
      "type": "string",
      "enum": [
        "toggle",
        "unlock_page",
        "upgrade",
        "badge",
        "activate_feature"
      ]
    },
    "feature_path": {
      "type": "string"
    },
    "royalties_config": {
      "type": "object"
    },
    "allowed_agent_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "webmcp_manifest": {
      "type": "object"
    },
    "chrome_skill_instructions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "mint_status": {
      "type": "string",
      "enum": [
        "draft",
        "prepared",
        "simulated",
        "minted_mainnet",
        "failed"
      ],
      "default": "draft"
    },
    "xrpl_mint_payload": {
      "type": "object"
    },
    "xrpl_tx_hash": {
      "type": "string"
    },
    "xrpl_network": {
      "type": "string",
      "enum": [
        "mainnet",
        "testnet",
        "devnet"
      ],
      "default": "mainnet"
    },
    "metadata_uri": {
      "type": "string"
    },
    "transferable": {
      "type": "boolean",
      "default": false
    },
    "burnable": {
      "type": "boolean",
      "default": false
    },
    "taxon": {
      "type": "number",
      "default": 0
    },
    "transfer_fee": {
      "type": "number",
      "default": 0
    },
    "immutable_after_mint": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "description",
    "widget_type",
    "widget_class",
    "category",
    "version",
    "minted_by",
    "ui_behavior"
  ]
}