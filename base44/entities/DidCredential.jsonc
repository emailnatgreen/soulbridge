{
  "name": "DidCredential",
  "type": "object",
  "properties": {
    "issuer_did": {
      "type": "string",
      "description": "DID that issued the credential"
    },
    "subject_did": {
      "type": "string",
      "description": "DID that received the credential"
    },
    "issuer_wallet_id": {
      "type": "string",
      "description": "Issuer's wallet ID"
    },
    "subject_wallet_id": {
      "type": "string",
      "description": "Subject's wallet ID"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "identity_verified",
        "skill_certification",
        "professional_license",
        "educational_degree",
        "membership",
        "authorization",
        "achievement",
        "compliance_attestation",
        "custom"
      ],
      "description": "Type of credential"
    },
    "credential_name": {
      "type": "string",
      "description": "Human-readable credential name"
    },
    "credential_data": {
      "type": "object",
      "description": "Credential claims and data"
    },
    "proof": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "verification_method": {
          "type": "string"
        },
        "proof_value": {
          "type": "string"
        }
      },
      "description": "Cryptographic proof"
    },
    "issuance_date": {
      "type": "string",
      "description": "When credential was issued"
    },
    "expiration_date": {
      "type": "string",
      "description": "When credential expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired",
        "suspended"
      ],
      "default": "active",
      "description": "Credential status"
    },
    "revocation_reason": {
      "type": "string",
      "description": "Reason if revoked"
    },
    "revoked_at": {
      "type": "string",
      "description": "When credential was revoked"
    },
    "is_verified": {
      "type": "boolean",
      "default": true,
      "description": "Whether credential has been verified"
    },
    "verification_count": {
      "type": "number",
      "default": 0,
      "description": "How many times credential was verified"
    },
    "last_verified": {
      "type": "string",
      "description": "Last verification timestamp"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "shared"
      ],
      "default": "private",
      "description": "Who can see this credential"
    }
  },
  "required": [
    "issuer_did",
    "subject_did",
    "credential_type",
    "credential_name"
  ]
}