{
  "name": "MarketplaceTransaction",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string",
      "description": "MarketplaceResource or ResourceListing being purchased"
    },
    "listing_id": {
      "type": "string",
      "description": "ResourceListing ID (for Didit bridge purchases)"
    },
    "resource_name": {
      "type": "string",
      "description": "Human-readable name of the purchased resource"
    },
    "buyer_agent_id": {
      "type": "string",
      "description": "Agent purchasing the resource"
    },
    "buyer_did": {
      "type": "string",
      "description": "DID of the buyer (from Didit bridge)"
    },
    "seller_agent_id": {
      "type": "string",
      "description": "Agent selling the resource"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "RLUSD_ON_XRPL",
        "PAYPAL_FIAT",
        "LEGACY"
      ],
      "default": "RLUSD_ON_XRPL",
      "description": "Canonical payment method \u2014 RLUSD on XRPL, PayPal fiat, or LEGACY for historical records"
    },
    "unit_amount": {
      "type": "number",
      "description": "Price in smallest unit (canonical amount field)"
    },
    "purchase_price_drops": {
      "type": "number",
      "description": "LEGACY \u2014 Amount paid in drops (XRP)"
    },
    "purchase_price_rlusd": {
      "type": "number",
      "description": "LEGACY \u2014 Amount paid in RLUSD"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Number of units purchased"
    },
    "currency": {
      "type": "string",
      "enum": [
        "XRP",
        "RLUSD",
        "PYUSD",
        "USD"
      ],
      "default": "RLUSD",
      "description": "LEGACY \u2014 Payment currency (kept for historical records only)"
    },
    "payment_reference": {
      "type": "string",
      "description": "External payment reference (XRPL tx hash, PayPal ID, etc.)"
    },
    "source": {
      "type": "string",
      "enum": [
        "soulbridge",
        "didit_bridge",
        "direct"
      ],
      "default": "soulbridge",
      "description": "Where the transaction originated"
    },
    "marketplace_type": {
      "type": "string",
      "enum": [
        "widget",
        "service",
        "resource",
        "advanced_resource",
        "agent"
      ],
      "description": "Which marketplace category this transaction belongs to"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "delivered",
        "treasury_received",
        "distributed",
        "failed",
        "cancelled",
        "refunded"
      ],
      "default": "pending",
      "description": "Transaction status"
    },
    "treasury_transaction_hash": {
      "type": "string",
      "description": "Treasury receipt reference"
    },
    "xrpl_transaction_hash": {
      "type": "string",
      "description": "XRPL ledger hash if applicable"
    },
    "delivery_id": {
      "type": "string",
      "description": "Delivery or contract ID after mint/assign"
    },
    "nft_id": {
      "type": "string",
      "description": "NFT or access token ID after delivery"
    },
    "distribution_details": {
      "type": "object",
      "properties": {
        "seller_receives_rlusd": {
          "type": "number"
        },
        "village_fee_rlusd": {
          "type": "number"
        },
        "royalty_distributions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "recipient_agent_id": {
                "type": "string"
              },
              "amount_rlusd": {
                "type": "number"
              }
            }
          }
        },
        "treasury_fee_rlusd": {
          "type": "number"
        }
      },
      "description": "How payment was distributed"
    },
    "audit_signature": {
      "type": "string",
      "description": "Immutable audit proof"
    },
    "completion_date": {
      "type": "string",
      "description": "When transaction completed"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if failed"
    },
    "metadata": {
      "type": "object",
      "description": "Additional transaction context"
    }
  },
  "required": [
    "buyer_agent_id",
    "seller_agent_id",
    "payment_method",
    "status"
  ]
}