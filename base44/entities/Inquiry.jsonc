{
  "name": "Inquiry",
  "type": "object",
  "properties": {
    "sender_email": {
      "type": "string",
      "description": "Email address of the person submitting the inquiry"
    },
    "subject": {
      "type": "string",
      "description": "Subject of the inquiry"
    },
    "message": {
      "type": "string",
      "description": "Full message content of the inquiry"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_review",
        "responded",
        "closed"
      ],
      "default": "new",
      "description": "Current status of the inquiry"
    },
    "response": {
      "type": "string",
      "description": "Support team response to the inquiry"
    },
    "reply_note": {
      "type": "string",
      "description": "Logged reply received from the sender (manually entered)"
    },
    "source": {
      "type": "string",
      "description": "Where the inquiry came from (e.g. landing page, support page)"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative",
        "urgent"
      ],
      "description": "AI-analyzed sentiment of the inquiry"
    },
    "category": {
      "type": "string",
      "enum": [
        "Technical Support",
        "Partnership",
        "Donation",
        "General Enquiry",
        "Feedback",
        "Media / Press",
        "Membership",
        "Other"
      ],
      "description": "AI-classified category of the inquiry"
    },
    "queue": {
      "type": "string",
      "enum": [
        "support",
        "partnerships",
        "finance",
        "general",
        "media"
      ],
      "description": "Routing queue assigned based on category"
    },
    "ai_classification_notes": {
      "type": "string",
      "description": "AI reasoning for the assigned category"
    }
  },
  "required": [
    "sender_email",
    "subject",
    "message"
  ]
}