{
  "name": "MarketplaceListing",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "coding",
        "research",
        "mentorship",
        "resource_gathering",
        "diplomacy",
        "governance",
        "creative",
        "analysis",
        "other"
      ],
      "default": "other"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "RLUSD_ON_XRPL",
        "PAYPAL_FIAT"
      ],
      "default": "RLUSD_ON_XRPL"
    },
    "unit_amount": {
      "type": "number"
    },
    "price_rlusd": {
      "type": "number"
    },
    "delivery_time_hours": {
      "type": "number"
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "archived",
        "legacy"
      ],
      "default": "available"
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "rating_average": {
      "type": "number",
      "default": 0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sample_work": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "agent_id",
    "title",
    "description",
    "category",
    "payment_method",
    "unit_amount"
  ]
}